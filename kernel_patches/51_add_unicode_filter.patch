From: Claude Code <noreply@anthropic.com>
Subject: [PATCH] Add Unicode filter hooks to kernel syscalls

Add hooks for the Unicode filter in fs/open.c and fs/stat.c.
The filter function (susfs_check_unicode_bypass) is provided by
susfs.c which is copied from the susfs4ksu repo during build.

Hooks added:
- fs/open.c: do_faccessat, do_sys_openat2
- fs/stat.c: vfs_statx

Signed-off-by: Claude Code <noreply@anthropic.com>
---
 fs/open.c |   17 +++++++++++++++++
 fs/stat.c |   12 ++++++++++++
 2 files changed, 29 insertions(+)

--- a/fs/open.c
+++ b/fs/open.c
@@ -35,6 +35,10 @@
 #include "internal.h"
 #include <trace/hooks/syscall_check.h>

+#ifdef CONFIG_KSU_SUSFS_UNICODE_FILTER
+#include <linux/susfs.h>
+#endif
+
 int do_truncate(struct dentry *dentry, loff_t length, unsigned int time_attrs,
 	struct file *filp)
 {
@@ -398,6 +402,11 @@ static long do_faccessat(int dfd, const
 	unsigned int lookup_flags = LOOKUP_FOLLOW;
 	const struct cred *old_cred = NULL;

+#ifdef CONFIG_KSU_SUSFS_UNICODE_FILTER
+	if (susfs_check_unicode_bypass(filename))
+		return -ENOENT;
+#endif
+
 	if (mode & ~S_IRWXO)	/* where's F_OK, X_OK, W_OK, R_OK? */
 		return -EINVAL;

@@ -1201,6 +1210,11 @@ static long do_sys_openat2(int dfd, cons
 	int fd = build_open_flags(how, &op);
 	struct filename *tmp;

+#ifdef CONFIG_KSU_SUSFS_UNICODE_FILTER
+	if (susfs_check_unicode_bypass(filename))
+		return -ENOENT;
+#endif
+
 	if (fd)
 		return fd;

--- a/fs/stat.c
+++ b/fs/stat.c
@@ -22,6 +22,10 @@

 #include "internal.h"
 #include "mount.h"
+
+#ifdef CONFIG_KSU_SUSFS_UNICODE_FILTER
+#include <linux/susfs.h>
+#endif

 /**
  * generic_fillattr - Fill in the basic attributes from the inode struct
@@ -174,6 +178,11 @@ static int vfs_statx(int dfd, const char
 	unsigned lookup_flags = 0;
 	int error;

+#ifdef CONFIG_KSU_SUSFS_UNICODE_FILTER
+	if (filename && susfs_check_unicode_bypass(filename))
+		return -ENOENT;
+#endif
+
 	if (flags & ~(AT_SYMLINK_NOFOLLOW | AT_NO_AUTOMOUNT | AT_EMPTY_PATH |
 		      AT_STATX_SYNC_TYPE))
 		return -EINVAL;
