+	ksu_sucompat_exit();
+#endif

 	sukisu_custom_config_exit();

diff --git a/kernel/supercalls.c b/kernel/supercalls.c
--- a/kernel/supercalls.c
+++ b/kernel/supercalls.c
@@ -22,7 +22,9 @@
 #include "manager.h"
 #include "selinux/selinux.h"
 #include "file_wrapper.h"
+#ifndef CONFIG_KSU_SUSFS
 #include "syscall_hook_manager.h"
+#endif
 #include "throne_comm.h"
 #include "dynamic_manager.h"

@@ -386,6 +388,7 @@ static int do_manage_mark(void __user *arg)
 	}

 	switch (cmd.operation) {
+#ifndef CONFIG_KSU_SUSFS
 	case KSU_MARK_GET: {
 		ret = ksu_get_task_mark(cmd.pid);
 		if (ret < 0) {
@@ -418,6 +421,16 @@ static int do_manage_mark(void __user *arg)
 		pr_info("manage_mark: refreshed running processes\n");
 		break;
 	}
+#else
+	case KSU_MARK_GET:
+	case KSU_MARK_MARK:
+	case KSU_MARK_UNMARK:
+	case KSU_MARK_REFRESH: {
+		pr_info("manage_mark: SUSFS mode - operation %u\n", cmd.operation);
+		break;
+	}
+#endif
 	default: {
 		pr_err("manage_mark: invalid operation %u\n", cmd.operation);
 		return -EINVAL;
