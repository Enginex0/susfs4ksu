diff --git a/kernel/Kconfig b/kernel/Kconfig
--- a/kernel/Kconfig
+++ b/kernel/Kconfig
@@ -33,4 +33,95 @@ config KPM
     select KALLSYMS
     select KALLSYMS_ALL

+menu "KernelSU - SUSFS"
+config KSU_SUSFS
+    bool "KernelSU addon - SUSFS"
+    depends on KSU
+    default y
+    help
+        Patch and Enable SUSFS to kernel with KernelSU.
+
+config KSU_SUSFS_HAS_MAGIC_MOUNT
+    bool "Enable magic mount support"
+    depends on KSU_SUSFS
+    default y
+    help
+        Enable magic mount support for SUSFS.
+
+config KSU_SUSFS_SUS_PATH
+    bool "Enable to hide suspicious path"
+    depends on KSU_SUSFS
+    default y
+    help
+        Allow hiding the user-defined path and all its sub-paths.
+
+config KSU_SUSFS_SUS_MOUNT
+    bool "Enable to hide suspicious mounts"
+    depends on KSU_SUSFS
+    default y
+    help
+        Allow hiding mount paths from /proc/self/mounts.
+
+config KSU_SUSFS_AUTO_ADD_SUS_KSU_DEFAULT_MOUNT
+    bool "Auto add default KSU mounts"
+    depends on KSU_SUSFS_SUS_MOUNT
+    default y
+    help
+        Automatically add default KSU mounts to suspicious mount list.
+
+config KSU_SUSFS_AUTO_ADD_SUS_BIND_MOUNT
+    bool "Auto add bind mounts"
+    depends on KSU_SUSFS_SUS_MOUNT
+    default y
+    help
+        Automatically add bind mounts to suspicious mount list.
+
+config KSU_SUSFS_SUS_KSTAT
+    bool "Enable to spoof suspicious kstat"
+    depends on KSU_SUSFS
+    default y
+    help
+        Allow spoofing the kstat of user-defined file/directory.
+
+config KSU_SUSFS_SUS_OVERLAYFS
+    bool "Enable suspicious overlayfs hiding"
+    depends on KSU_SUSFS
+    default y
+    help
+        Enable overlayfs detection prevention.
+
+config KSU_SUSFS_TRY_UMOUNT
+    bool "Enable try umount"
+    depends on KSU_SUSFS
+    default y
+    help
+        Enable try umount functionality.
+
+config KSU_SUSFS_SPOOF_UNAME
+    bool "Enable to spoof uname"
+    depends on KSU_SUSFS
+    default y
+    help
+        Allow spoofing the string returned by uname syscall.
+
+config KSU_SUSFS_ENABLE_LOG
+    bool "Enable logging susfs log to kernel"
+    depends on KSU_SUSFS
+    default y
+    help
+        Allow logging susfs log to kernel.
+
+config KSU_SUSFS_HIDE_KSU_SUSFS_SYMBOLS
+    bool "Hide ksu and susfs symbols"
+    depends on KSU_SUSFS
+    default y
+    help
+        Hide ksu and susfs symbols from /proc/kallsyms.
+
+config KSU_SUSFS_SUS_PROC
+    bool "Hide processes from /proc"
+    depends on KSU_SUSFS
+    default y
+    help
+        Hide ksud from /proc enumeration.
+
+config KSU_SUSFS_UNICODE_FILTER
+    bool "Unicode security filter"
+    depends on KSU_SUSFS
+    default y
+    help
+        Block Unicode bypass attacks.
+
+endmenu
+
 endmenu
diff --git a/kernel/ksu.c b/kernel/ksu.c
